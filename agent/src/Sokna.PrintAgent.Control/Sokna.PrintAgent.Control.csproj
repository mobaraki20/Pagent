<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <OutputType>WinExe</OutputType>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationIcon>../../assets/Sokna.PrintAgent.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <StartupObject>Sokna.PrintAgent.Control.Program</StartupObject>
  </PropertyGroup>
  <ItemGroup>
    <Resource Include="../../assets/Sokna.PrintAgent.ico" Link="Assets/Sokna.PrintAgent.ico" />
    <ProjectReference Include="../Sokna.PrintAgent.Core/Sokna.PrintAgent.Core.csproj" />
    <PackageReference Include="System.ServiceProcess.ServiceController" />
  </ItemGroup>
</Project>
