<Project>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <LangVersion>14.0</LangVersion>
    <Deterministic>true</Deterministic>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <ContinuousIntegrationBuild Condition="'$(CI)'=='true'">true</ContinuousIntegrationBuild>

    <!-- Single source of truth for every Agent binary and package. -->
    <SoknaAgentVersion>6.2.3</SoknaAgentVersion>
    <Version>$(SoknaAgentVersion)</Version>
    <AssemblyVersion>$(SoknaAgentVersion).0</AssemblyVersion>
    <FileVersion>$(SoknaAgentVersion).0</FileVersion>
    <InformationalVersion>$(SoknaAgentVersion)</InformationalVersion>
  </PropertyGroup>
</Project>
